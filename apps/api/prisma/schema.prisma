// NURTW Membership and Vehicle Verification System — data model.
//
// ARCHITECTURE.md §2: this schema is the single source of truth, and the
// migration history is the durable record of structural change.
//
// Column names follow the canonical catalogue at PRD §24 verbatim, via @map.
// TypeScript-side fields stay camelCase. The database names are contractual —
// they are the shared vocabulary with the Union — so they are not re-spelled to
// suit an ORM convention.
//
// Two rules govern what becomes an enum:
//   * Record lifecycles are enums. They are closed sets fixed by the PRD, and a
//     boolean cannot express the difference between never-issued, replaced, and
//     reported-lost — yet those must produce different verification outcomes.
//   * Master data is NEVER an enum. PRD §23.4 promised the Union it could change
//     designations, branches, units, categories, and their lists without a
//     deployment. An enum would silently break that promise.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 removed `url` from the datasource block. The connection string for
// migration and introspection now lives in prisma.config.ts, and the runtime
// client receives a driver adapter instead. See ARCHITECTURE.md Decision 12.1 —
// the connection is environment configuration and never appears in code.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Lifecycles (PRD §8, §9, §10, §12.1)
// ---------------------------------------------------------------------------

/// PRD §23.1 — Council -> Zone -> Branch -> Unit -> Member.
enum OrganisationLevel {
  COUNCIL
  ZONE
  BRANCH
  UNIT
}

/// PRD §5 — an active member is approved and not suspended, cancelled, or
/// otherwise inactive.
enum MemberStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CANCELLED
}

/// PRD §7 — application review and approval.
enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
}

/// PRD §8 — nine states.
enum CardStatus {
  DRAFT
  PENDING_APPROVAL
  ISSUED
  ACTIVE
  SUSPENDED
  LOST
  REPLACED
  EXPIRED
  CANCELLED
}

/// PRD §10 — nine states. DAMAGED is present here and absent from CardStatus.
enum StickerStatus {
  DRAFT
  ISSUED
  ACTIVE
  SUSPENDED
  LOST
  REPLACED
  DAMAGED
  EXPIRED
  CANCELLED
}

/// PRD §9 — six states.
enum DeclarationStatus {
  /// Revision 1.2, ARCHITECTURE.md Decision 6.5 — a migrated vehicle (item 09)
  /// starts and stays here until `vehicle.declare` PROMOTES this row to
  /// ACTIVE. Never created by the API's own declare path.
  ON_RECORD
  PENDING
  ACTIVE
  SUSPENDED
  RETIRED
  DISPUTED
  ARCHIVED
}

/// PRD §12.1 — external client lifecycle.
enum ApiClientStatus {
  PENDING
  ACTIVE
  SUSPENDED
  EXPIRED
  REVOKED
}

/// PRD §26.4 — every verification records which identifier scheme resolved it,
/// so the Union can quantify legacy exposure over time and revisit the
/// equivalence determination on evidence rather than argument.
enum IdentifierScheme {
  SIGNED
  LEGACY
}

/// PRD §23.7 and the card artwork (DESIGN.md §7.4) — the card carries three
/// signature lines, of which two are officers of the Union. The third is the
/// holder's own and comes from their member record, not from here.
enum OfficerSignaturePosition {
  PRESIDENT
  GENERAL_SECRETARY
}

/// Stored media. Held in object storage, never in the database and never in the
/// repository (ARCHITECTURE.md Decision 10.2). Rows here hold references only.
enum MediaKind {
  PASSPORT_PHOTOGRAPH
  MEMBER_SIGNATURE
  OFFICER_SIGNATURE
  COLLATERAL_EVIDENCE
}

// ---------------------------------------------------------------------------
// Organisation (PRD §6)
// ---------------------------------------------------------------------------

/// One self-referencing table rather than four.
///
/// ARCHITECTURE.md Decision 9.4 requires every permission assignment to carry an
/// organisational scope, and every authorisation check to ask "does the subject
/// record fall within the actor's scope". Against one table with a materialised
/// path that is a prefix match; against four tables it is a four-way union that
/// grows with every level the Union adds.
///
/// PRD Requirement 6.1 — every level exists in the model even where the Union
/// does not presently operate one, so a default node is seeded rather than the
/// level being omitted.
model Organisation {
  id       String            @id @default(uuid()) @db.Uuid
  name     String
  level    OrganisationLevel
  parentId String?           @map("parent_id") @db.Uuid

  /// Materialised ancestry, e.g. "/<council>/<zone>/<branch>/". Enables a scope
  /// check to be a single indexed prefix comparison. Maintained on write; a
  /// subtree move must rewrite descendants.
  path String

  /// PRD §23.2 — for a COUNCIL this is the issuing council's state, which is
  /// what the membership card prints. It is distinct from a member's state of
  /// origin and must never be conflated with it.
  stateName String? @map("state_name")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent   Organisation?  @relation("OrganisationHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Organisation[] @relation("OrganisationHierarchy")

  members          Member[]
  vehiclesByBranch Vehicle[]             @relation("VehicleBranch")
  vehiclesByUnit   Vehicle[]             @relation("VehicleUnit")
  roleAssignments  UserRoleAssignment[]
  permissionGrants UserPermissionGrant[]
  auditEvents      AuditEvent[]

  @@index([parentId])
  @@index([path])
  @@index([level])
  @@map("organisation")
}

// ---------------------------------------------------------------------------
// Master data (PRD §23.4) — administrable tables, never enums
// ---------------------------------------------------------------------------

/// Vehicle categories. Seeded from the legacy export and thereafter corrected and
/// extended by the Union through the interface.
///
/// PRD §23.17 — the seeded distribution is an opening baseline reflecting what
/// the previous system held, not a complete picture of the Union's fleet.
model VehicleCategory {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  label     String
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  vehicles Vehicle[]

  @@map("vehicle_category")
}

/// Route types — how a vehicle operates: interstate, intercity, town service
/// (PRD Requirement 9.9, revision 1.3). Master data like vehicle categories,
/// because the levy is priced per route type (Requirement 27.1) and the Union
/// must be able to add one without a deployment.
///
/// Distinct from `VehicleCategory`, which is the kind of vehicle. The legacy
/// categories `BUS_INTERSTATE`/`BUS_INTRASTATE` are NOT mapped onto this: a
/// route type inferred from a category would be indistinguishable from one
/// an officer recorded.
model RouteType {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  label     String
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  vehicles      Vehicle[]
  prices        FeeTypePrice[]
  amountHistory FeeAmountHistory[]
  changesTo     VehicleRouteTypeChange[] @relation("RouteTypeChangeTo")
  changesFrom   VehicleRouteTypeChange[] @relation("RouteTypeChangeFrom")

  @@map("route_type")
}

/// Member designations — the role printed on the membership card.
model Designation {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  label     String
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members Member[]

  @@map("designation")
}

/// Local government areas.
///
/// PRD §23.18 — approximately 1,908 of 2,841 legacy vehicles carry no LGA. They
/// are imported with the field blank and flagged for operational cleanup. The
/// relation is therefore optional throughout, and the migration must never infer
/// a value from address text: an inferred value would be indistinguishable from
/// a recorded one.
model Lga {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  stateName String   @map("state_name")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberContacts MemberContact[]
  nextOfKin      NextOfKin[]

  @@index([stateName])
  @@map("lga")
}

// ---------------------------------------------------------------------------
// Media (ARCHITECTURE.md Decision 10.2)
// ---------------------------------------------------------------------------

/// Object-storage reference. The bytes are never held here; access is by
/// time-limited signed URL issued at read time.
model MediaAsset {
  id          String    @id @default(uuid()) @db.Uuid
  kind        MediaKind
  storageKey  String    @unique @map("storage_key")
  contentType String    @map("content_type")
  byteSize    Int       @map("byte_size")
  createdAt   DateTime  @default(now()) @map("created_at")

  passportOf  Member? @relation("MemberPassportPhoto")
  signatureOf Member? @relation("MemberSignature")

  officerSignature   OfficerSignature? @relation("OfficerSignatureAsset")
  printedOnCards     Card[]            @relation("CardPrintedPhoto")
  printedSignatureOn Card[]            @relation("CardPrintedSignature")

  @@map("media_asset")
}

// ---------------------------------------------------------------------------
// Member (PRD §7) — card-display data
// ---------------------------------------------------------------------------

/// Card-display data only.
///
/// ARCHITECTURE.md Decision 10.1 — sensitive registration data lives in separate
/// tables, mediated by the member-profile module. The separation is structural,
/// not a matter of query discipline: a verification path that joins this table
/// cannot reach a telephone number or a guarantor, because they are not here.
///
/// PRD Requirement 7.1 and acceptance criterion 12 both depend on that.
model Member {
  id String @id @default(uuid()) @db.Uuid

  /// Allocated on approval, not on application (PRD §26.1, item 05).
  ///
  /// Nullable because a pending applicant is not yet a member: issuing a
  /// membership number to somebody whose application is later refused would put
  /// a number in the register that an officer could look up and that identifies
  /// no member. PostgreSQL admits many NULLs under a unique index, so pending
  /// applicants coexist without collision.
  ///
  /// Nothing is wasted by allocating late — §26.1 requires the number convey no
  /// sequence, so there is no counter to advance.
  membershipNumber String?      @unique @map("membership_number")
  status           MemberStatus @default(PENDING)

  surname    String
  firstName  String  @map("first_name")
  middleName String? @map("middle_name")

  organisationId String  @map("organisation_id") @db.Uuid
  designationId  String? @map("designation_id") @db.Uuid

  passportPhotoId String? @unique @map("passport_photo_id") @db.Uuid
  signatureId     String? @unique @map("signature_id") @db.Uuid

  /// Item 09 — the legacy `drivers.csv` row id this member was migrated
  /// from. The idempotency key for the migration script: a rerun upserts by
  /// this rather than creating a duplicate. Null for every member created
  /// through the registration flow.
  legacyId String? @unique @map("legacy_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organisation  Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  designation   Designation? @relation(fields: [designationId], references: [id], onDelete: Restrict)
  passportPhoto MediaAsset?  @relation("MemberPassportPhoto", fields: [passportPhotoId], references: [id])
  signature     MediaAsset?  @relation("MemberSignature", fields: [signatureId], references: [id])

  contact     MemberContact?
  nextOfKin   NextOfKin?
  guarantor   Guarantor?
  application MembershipApplication?
  cards       Card[]
  vehicles    Vehicle[]

  dedicatedAccounts  DedicatedAccount[]
  dedicatedTransfers DedicatedAccountTransfer[]

  @@index([organisationId])
  @@index([status])
  @@map("member")
}

/// Sensitive member data — telephone, residential address, state of origin.
///
/// Deliberately a separate table (Decision 10.1). Never exposed through any
/// verification path at any disclosure level (PRD acceptance criterion 12).
model MemberContact {
  id       String @id @default(uuid()) @db.Uuid
  memberId String @unique @map("member_id") @db.Uuid

  phone              String
  residentialAddress String  @map("residential_address")
  area               String?
  townCity           String? @map("town_city")
  residentialLgaId   String? @map("residential_lga_id") @db.Uuid
  stateOfOrigin      String? @map("state_of_origin")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  member         Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  residentialLga Lga?   @relation(fields: [residentialLgaId], references: [id], onDelete: Restrict)

  @@map("member_contact")
}

/// PRD §7 — next of kin. Sensitive; never reachable through verification.
model NextOfKin {
  id       String @id @default(uuid()) @db.Uuid
  memberId String @unique @map("member_id") @db.Uuid

  surname    String
  firstName  String  @map("first_name")
  middleName String? @map("middle_name")

  address       String
  area          String?
  townCity      String? @map("town_city")
  lgaId         String? @map("lga_id") @db.Uuid
  stateOfOrigin String? @map("state_of_origin")
  phone         String
  occupation    String?

  signatureDate DateTime? @map("signature_date")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  lga    Lga?   @relation(fields: [lgaId], references: [id], onDelete: Restrict)

  @@map("next_of_kin")
}

/// PRD §7 — guarantor, including the collateral response.
///
/// PRD Requirement 7.1 lists collateral among the data that must never surface
/// through verification.
model Guarantor {
  id       String @id @default(uuid()) @db.Uuid
  memberId String @unique @map("member_id") @db.Uuid

  surname    String
  firstName  String  @map("first_name")
  middleName String? @map("middle_name")

  address                 String
  area                    String?
  townCity                String? @map("town_city")
  relationshipToApplicant String  @map("relationship_to_applicant")
  phone                   String
  occupation              String?

  hasCollateral     Boolean? @map("has_collateral")
  collateralDetails String?  @map("collateral_details")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("guarantor")
}

/// PRD §7 — application, review, and approval, with the decision history
/// retrievable (acceptance criterion 1).
model MembershipApplication {
  id                String            @id @default(uuid()) @db.Uuid
  applicationNumber String            @unique @map("application_number")
  status            ApplicationStatus @default(DRAFT)

  memberId String? @unique @map("member_id") @db.Uuid

  /// The officer who recorded the application.
  ///
  /// Captured so that "did one person record this and then approve it" is a
  /// question the database can answer, rather than one requiring an audit-trail
  /// search. Nullable because applications created before this column existed
  /// have no creator recorded on the row; those are backfilled from the audit
  /// trail where the event survives, and stay null where it does not.
  ///
  /// Whether a *different* officer must decide is a runtime setting
  /// (`approval.require_separate_officer`), off by default pending
  /// QUESTIONS.md MEM-04.
  createdByUserId String? @map("created_by_user_id") @db.Uuid

  submittedAt      DateTime? @map("submitted_at")
  reviewedByUserId String?   @map("reviewed_by_user_id") @db.Uuid
  reviewedAt       DateTime? @map("reviewed_at")
  rejectionReason  String?   @map("rejection_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  member         Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  createdByUser  User?   @relation("ApplicationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  reviewedByUser User?   @relation("ApplicationReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("membership_application")
}

// ---------------------------------------------------------------------------
// Card (PRD §8)
// ---------------------------------------------------------------------------

model Card {
  id String @id @default(uuid()) @db.Uuid

  /// Allocated when the card is issued, not when it is drafted (item 06).
  ///
  /// Nullable for the same reason `Member.membershipNumber` is: a DRAFT card is a
  /// proposal to print a card, and a cancelled draft was never printed and is in
  /// nobody's pocket. A number against it would sit in the register naming an
  /// artifact that does not exist — and the register is exactly where an officer
  /// goes to ask whether a card presented to them is real.
  ///
  /// Nothing is wasted by allocating late: §26.1 requires the number convey no
  /// sequence, so there is no counter to advance.
  cardNumber String?    @unique @map("card_number")
  memberId   String     @map("member_id") @db.Uuid
  status     CardStatus @default(DRAFT)

  issueDate  DateTime? @map("issue_date")
  expiryDate DateTime? @map("expiry_date")

  /// PRD §23.5 — validity is configurable per template, so a redesign or a change
  /// of renewal policy does not invalidate cards already issued.
  ///
  /// The version selects the template *module* that renders this card, so a card
  /// issued years ago re-renders exactly as it was printed. Removing a template
  /// module therefore breaks every card issued under it; the registry test says so.
  templateVersion String @map("template_version")

  /// PRD §8 Requirement 8.1 — a replacement preserves its relationship to the
  /// card it supersedes (acceptance criterion 2). History is never overwritten.
  replacementOfCardId String? @unique @map("replacement_of_card_id") @db.Uuid

  issuedByUserId   String? @map("issued_by_user_id") @db.Uuid
  approvedByUserId String? @map("approved_by_user_id") @db.Uuid

  // --- What was printed on the card ----------------------------------------
  //
  // A snapshot taken at issuance and never recomputed.
  //
  // A card is a physical object. The member transfers between branches, a
  // designation is renamed, a spelling is corrected — and the card in their
  // pocket still reads what it read on the day it was printed. Re-rendering from
  // live member data would produce a *different card bearing the same number*,
  // which defeats verification: the officer at the roadside compares what is in
  // their hand against what the System says, so the System must say what was
  // printed.
  //
  // `card.membership_number` is in the canonical field catalogue (proposal §24)
  // as a column on the card, which is the same instinct.

  printedName String? @map("printed_name")

  /// The card-display address (proposal §8), which may be shorter than the
  /// residential one. Composed by the issuing officer and held here, so the card
  /// module never joins `member_contact` (Decision 10.1).
  printedAddress String? @map("printed_address")

  printedDesignation String? @map("printed_designation")

  /// PRD Requirement 8.2 — the issuing council's state, never the member's state
  /// of origin.
  printedState String? @map("printed_state")

  printedBranch    String? @map("printed_branch")
  printedUnit      String? @map("printed_unit")
  membershipNumber String? @map("membership_number")

  /// The photograph and holder signature as composited, so a reprint of a
  /// damaged card matches the original even if the member has since uploaded a
  /// newer photograph.
  printedPhotoId     String? @map("printed_photo_id") @db.Uuid
  printedSignatureId String? @map("printed_signature_id") @db.Uuid

  /// The officer signatures as composited (PRD §23.7). Referencing the signature
  /// record rather than the image carries the officer's name and title along with
  /// it, so a card issued under a president who has since left office is still
  /// explicable.
  presidentSignatureId        String? @map("president_signature_id") @db.Uuid
  generalSecretarySignatureId String? @map("general_secretary_signature_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  member         Member @relation(fields: [memberId], references: [id], onDelete: Restrict)
  replacementOf  Card?  @relation("CardReplacement", fields: [replacementOfCardId], references: [id])
  replacedBy     Card?  @relation("CardReplacement")
  issuedByUser   User?  @relation("CardIssuedBy", fields: [issuedByUserId], references: [id], onDelete: SetNull)
  approvedByUser User?  @relation("CardApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  printedPhoto     MediaAsset? @relation("CardPrintedPhoto", fields: [printedPhotoId], references: [id], onDelete: Restrict)
  printedSignature MediaAsset? @relation("CardPrintedSignature", fields: [printedSignatureId], references: [id], onDelete: Restrict)

  presidentSignature        OfficerSignature? @relation("CardPresidentSignature", fields: [presidentSignatureId], references: [id], onDelete: Restrict)
  generalSecretarySignature OfficerSignature? @relation("CardGeneralSecretarySignature", fields: [generalSecretarySignatureId], references: [id], onDelete: Restrict)

  @@index([memberId])
  @@index([status])
  @@map("card")
}

/// A Union officer's signature, held as an asset and composited at print
/// (PRD §23.7).
///
/// Superseded rather than overwritten. An officer leaves office and their
/// successor's signature becomes active, but every card already issued bearing
/// the old signature must remain explicable — so the old record stays, inactive,
/// and the cards referencing it keep resolving.
///
/// The whole surface is gated by `card_template.manage` and fully audited: a
/// forged signature asset would forge every card issued after it.
model OfficerSignature {
  id       String                   @id @default(uuid()) @db.Uuid
  position OfficerSignaturePosition

  /// The officer's name and title **as printed on the card**, which is not
  /// necessarily how they appear in the user directory.
  officerName  String @map("officer_name")
  officerTitle String @map("officer_title")

  mediaAssetId String @unique @map("media_asset_id") @db.Uuid

  /// At most one active signature per position, enforced by a partial unique
  /// index in the migration — Prisma cannot express one.
  isActive   Boolean   @default(true) @map("is_active")
  activeFrom DateTime  @default(now()) @map("active_from")
  activeTo   DateTime? @map("active_to")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  mediaAsset MediaAsset @relation("OfficerSignatureAsset", fields: [mediaAssetId], references: [id], onDelete: Restrict)

  presidentOnCards          Card[]          @relation("CardPresidentSignature")
  generalSecretaryOnCards   Card[]          @relation("CardGeneralSecretarySignature")
  presidentOnLetters        VehicleLetter[] @relation("LetterPresidentSignature")
  generalSecretaryOnLetters VehicleLetter[] @relation("LetterGeneralSecretarySignature")

  @@index([position, isActive])
  @@map("officer_signature")
}

// ---------------------------------------------------------------------------
// Vehicle (PRD §9)
// ---------------------------------------------------------------------------

model Vehicle {
  id String @id @default(uuid()) @db.Uuid

  /// PRD Requirement 9.1 — stored twice. The normalised column carries the
  /// uniqueness constraint and is the ONLY field used for lookup or matching.
  /// The display column preserves the value exactly as entered.
  plateNumberNormalized String @map("plate_number_normalized")
  plateNumberDisplay    String @map("plate_number_display")

  vehicleCategoryId String? @map("vehicle_category_id") @db.Uuid
  make              String?
  model             String?
  color             String?

  /// PRD Requirement 9.9 (revision 1.3). Required by the API for every vehicle
  /// recorded or declared from 1.3 onwards; nullable here because legacy rows
  /// lawfully carry none (Decision 6.6).
  routeTypeId String? @map("route_type_id") @db.Uuid

  /// PRD Requirement 9.4 — restricted. Excluded from every disclosure profile and
  /// from default query selections. Never exposed through an external API.
  chassisVinRestricted String? @map("chassis_vin_restricted")

  declaredByMemberId String?           @map("declared_by_member_id") @db.Uuid
  branchId           String?           @map("branch_id") @db.Uuid
  unitId             String?           @map("unit_id") @db.Uuid
  status             DeclarationStatus @default(PENDING)
  /// Revision 1.2, ARCHITECTURE.md Decision 6.5 — nullable. `null` for an
  /// `ON_RECORD` row: a migrated vehicle has never been declared, so there
  /// is no date to record here. Stamped only when `vehicle.declare`
  /// promotes the row to `ACTIVE` (a fresh declaration still stamps it
  /// immediately, via the same default).
  declaredAt         DateTime?         @default(now()) @map("declared_at")
  /// `QUESTIONS.md` PAY-19 — when the vehicle was retired. Set once, with the
  /// move to `RETIRED`, which is terminal. The levy stops after that month.
  retiredAt          DateTime?         @map("retired_at")

  /// PRD §9.5 — declaration is a manual, permissioned act. The migration is the
  /// sole exception and marks its records so they remain distinguishable in the
  /// audit trail from an operator declaration.
  isLegacyImport Boolean @default(false) @map("is_legacy_import")

  /// The legacy `vehicles_full.csv` row id this declaration was migrated
  /// from — the migration script's idempotency key, same reasoning as
  /// `Member.legacyId`. Null for every declaration made through the API.
  legacyId String? @unique @map("legacy_id")

  /// Internal operational notes. PRD §9.1 — never exposed through verification.
  notes String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  vehicleCategory  VehicleCategory? @relation(fields: [vehicleCategoryId], references: [id], onDelete: Restrict)
  routeType        RouteType?       @relation(fields: [routeTypeId], references: [id], onDelete: Restrict)
  declaredByMember Member?          @relation(fields: [declaredByMemberId], references: [id], onDelete: Restrict)
  branch           Organisation?    @relation("VehicleBranch", fields: [branchId], references: [id], onDelete: Restrict)
  unit             Organisation?    @relation("VehicleUnit", fields: [unitId], references: [id], onDelete: Restrict)

  owner            VehicleOwner?
  stickers         Sticker[]
  letters          VehicleLetter[]
  routeTypeChanges VehicleRouteTypeChange[]

  /// PRD Requirement 9.2 — at most one ACTIVE declaration per normalised plate.
  ///
  /// Enforced by a PARTIAL unique index, added as raw SQL in the migration
  /// because Prisma cannot express one in the schema:
  ///
  ///     CREATE UNIQUE INDEX ... ON vehicle (plate_number_normalized)
  ///     WHERE status = 'ACTIVE'
  ///
  /// A plain `@@unique([plateNumberNormalized, status])` is WRONG here and was
  /// the first attempt. It permits only one row per status per plate, so a
  /// vehicle could be retired exactly once and never again — which contradicts
  /// PRD §4.8, history is preserved. Declared, retired, re-declared, retired
  /// again is a legitimate sequence and must remain possible.
  ///
  /// Revision 1.3 (Decision 6.6) adds a second partial unique index, also raw
  /// SQL: at most one ON_RECORD row per plate, so two enumerators recording the
  /// same vehicle at once cannot both succeed.
  ///
  ///     CREATE UNIQUE INDEX vehicle_one_on_record_per_plate
  ///     ON vehicle (plate_number_normalized) WHERE status = 'ON_RECORD'
  @@index([plateNumberNormalized])
  @@index([status])
  @@index([declaredByMemberId])
  @@index([routeTypeId])
  @@map("vehicle")
}

/// The vehicle's owner (PRD Requirement 9.8, revision 1.3). Not necessarily a
/// member: the driver is the member, the owner may be anyone.
///
/// A separate table for the same reason `MemberContact` is one (Decision
/// 10.1.1): phone and address are sensitive under Requirement 7.1, and keeping
/// them off `vehicle` means no verification or aggregate query can select them
/// by accident — the separation is structural, not query discipline.
///
/// Every column is nullable because legacy rows carry whatever the export held,
/// gaps included (Requirement 25.4). Name and phone are required by the API for
/// every vehicle recorded or declared through the System.
model VehicleOwner {
  id        String @id @default(uuid()) @db.Uuid
  vehicleId String @unique @map("vehicle_id") @db.Uuid

  ownerName    String? @map("owner_name")
  ownerPhone   String? @map("owner_phone")
  ownerAddress String? @map("owner_address")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Cascade, as `MemberContact` does: the owner row is part of the vehicle
  /// record, not a record of its own. Vehicles are never deleted in the
  /// application (history is preserved), so this only matters to test cleanup.
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("vehicle_owner")
}

/// Every route type a vehicle has been given (`QUESTIONS.md` PAY-19 — item
/// 25). The levy prices each month at the route type in force on its 1st, so
/// changing a vehicle's route type must not reprice the months before.
///
/// Append-only, written in the transaction that sets the route type. Kept from
/// item 25 onwards: a month before a vehicle's first row takes the route type
/// that row replaced (`routeTypeInForce`).
model VehicleRouteTypeChange {
  id                  String   @id @default(uuid()) @db.Uuid
  vehicleId           String   @map("vehicle_id") @db.Uuid
  routeTypeId         String   @map("route_type_id") @db.Uuid
  /// `null` when the vehicle had no route type before.
  previousRouteTypeId String?  @map("previous_route_type_id") @db.Uuid
  changedAt           DateTime @default(now()) @map("changed_at")

  /// Cascade, as `VehicleOwner` does: part of the vehicle's record. Vehicles
  /// are never deleted in the application.
  vehicle           Vehicle    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  routeType         RouteType  @relation("RouteTypeChangeTo", fields: [routeTypeId], references: [id], onDelete: Restrict)
  previousRouteType RouteType? @relation("RouteTypeChangeFrom", fields: [previousRouteTypeId], references: [id], onDelete: Restrict)

  @@index([vehicleId, changedAt])
  @@map("vehicle_route_type_change")
}

// ---------------------------------------------------------------------------
// Sticker (PRD §10, §26)
// ---------------------------------------------------------------------------

model Sticker {
  id String @id @default(uuid()) @db.Uuid

  /// Revision 1.2, Requirement 10.3 — nullable. A sticker may exist
  /// unattached: freshly signed and not yet issued to a vehicle, or a
  /// legacy barcode sitting on the imported Transpay register. Set exactly
  /// once, at attachment, and never changed afterward (a sticker attaches
  /// to at most one vehicle in its life, PRD §9A.4).
  vehicleId String?       @map("vehicle_id") @db.Uuid
  status    StickerStatus @default(DRAFT)

  /// PRD §26.1–26.2 — opaque, non-sequential, carrying no personal data and no
  /// derivable relationship to plate or member. The QR payload additionally
  /// carries a truncated HMAC and the key id; the signature itself is not stored,
  /// it is recomputed and compared.
  stickerQrId String @unique @map("sticker_qr_id")

  /// Identifies which signing key minted this sticker, so the secret can be
  /// rotated without invalidating articles already issued (PRD §26.2).
  signingKeyId String? @map("signing_key_id")

  /// PRD §26.4 — the legacy scheme, kept in a DISTINCT column from the signed
  /// identifier. Read-only: the issuance path has no route capable of producing
  /// one (Requirement 26.5). The legacy value is a millisecond epoch timestamp
  /// and is forgeable by inspection; the owner accepted this to preserve the
  /// 2,408 stickers already in the field.
  legacyBarcode String? @unique @map("legacy_barcode")

  /// Revision 1.2, Requirement 9A.3–9A.4 — for a legacy barcode only, the
  /// plate the imported Transpay register binds it to. Set once at import
  /// (item 09) and read-only thereafter: this is what a reattachment
  /// attempt is checked against, with no override (VEH-16). `null` for a
  /// freshly signed sticker, which carries no register entry at all.
  registeredPlateNormalized String? @map("registered_plate_normalized")

  /// Plate recorded at ATTACHMENT (renamed in meaning, not only in nullability,
  /// by revision 1.2: previously stamped at issuance, when every sticker was
  /// born attached). PRD §26.3 — binding the sticker to a plate is what
  /// detects a genuine sticker presented against another vehicle, which a
  /// signature alone cannot do. `null` until attached.
  plateNumberAtIssue String? @map("plate_number_at_issue")

  /// Revision 1.2, Requirement 9A.2/10.3 — when this sticker was attached.
  /// `null` for an unattached sticker; set once and never cleared, since
  /// attachment is a one-vehicle-in-its-life event, not a toggle.
  attachedAt DateTime? @map("attached_at")

  /// Requirement 9A.1 — onboarding has its own actor, as declaration does.
  /// Set with `attachedAt`, once, and never changed.
  attachedByUserId String? @map("attached_by_user_id") @db.Uuid

  /// Requirement 9A.5 / `QUESTIONS.md` VEH-14 — the export's Transpay
  /// `security_code`, kept as a record only. It is not printed on the
  /// sticker, so it plays no part in reattachment or verification. Restricted:
  /// no response selects it.
  legacySecurityCode String? @map("legacy_security_code")

  /// The confirmed Paystack payment that funded this attachment (Requirement
  /// 9A.4's fourth condition). `@unique` so a payment reference can fund at
  /// most one attachment — the same enforcement Requirement 9A.4 asks for
  /// ("that reference has not been used before"), expressed as a
  /// constraint rather than a query a caller could forget to run.
  attachmentPaymentId String? @unique @map("attachment_payment_id") @db.Uuid

  issueDate  DateTime? @map("issue_date")
  expiryDate DateTime? @map("expiry_date")

  templateVersion String @map("template_version")

  replacementOfStickerId String? @unique @map("replacement_of_sticker_id") @db.Uuid
  issuedByUserId         String? @map("issued_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  vehicle           Vehicle?        @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  attachmentPayment Payment?        @relation(fields: [attachmentPaymentId], references: [id], onDelete: Restrict)
  replacementOf     Sticker?        @relation("StickerReplacement", fields: [replacementOfStickerId], references: [id])
  replacedBy        Sticker?        @relation("StickerReplacement")
  letters           VehicleLetter[]
  issuedByUser      User?           @relation("StickerIssuedBy", fields: [issuedByUserId], references: [id], onDelete: SetNull)
  attachedByUser    User?           @relation("StickerAttachedBy", fields: [attachedByUserId], references: [id], onDelete: SetNull)

  /// PRD §9A.4 — at most one ATTACHED sticker per vehicle at a time. A
  /// PARTIAL unique index, same technique as
  /// `vehicle_one_active_declaration_per_plate`: `SUSPENDED` counts as
  /// attached (an administrative hold, not a physical removal — see
  /// `isStickerAttached` in `@nurtw/domain`), so the predicate covers both.
  ///
  ///     CREATE UNIQUE INDEX ... ON sticker (vehicle_id)
  ///     WHERE status IN ('ACTIVE', 'SUSPENDED')
  @@index([vehicleId])
  @@index([status])
  @@index([registeredPlateNormalized])
  @@map("sticker")
}

/// The letter produced when a vehicle is onboarded (PRD Requirement 9A.6,
/// `QUESTIONS.md` VEH-19 — item 18).
///
/// Created in the same transaction as the sticker attachment, so a letter
/// exists exactly when an onboarding does. The printed values are a snapshot
/// taken then and never recomputed, for the card's reason: a letter is a
/// document someone carries, and re-deriving it from live data would produce a
/// different letter bearing the same reference. Reissuing one after a change is
/// open at VEH-27.
model VehicleLetter {
  id        String @id @default(uuid()) @db.Uuid
  vehicleId String @map("vehicle_id") @db.Uuid
  stickerId String @map("sticker_id") @db.Uuid

  /// Random, like the card number — printed on the letter and looked up
  /// internally (VEH-19). Not derivable from the plate or the order of issue.
  letterReference String @unique @map("letter_reference")

  /// Selects the template module that renders this letter. A template module
  /// must never be removed while letters reference it.
  templateVersion String   @map("template_version")
  issuedAt        DateTime @default(now()) @map("issued_at")
  issuedByUserId  String?  @map("issued_by_user_id") @db.Uuid

  // --- What the letter prints (snapshot at issue) ------------------------------
  printedPlate            String  @map("printed_plate")
  printedCategory         String? @map("printed_category")
  printedMake             String? @map("printed_make")
  printedModel            String? @map("printed_model")
  printedColour           String? @map("printed_colour")
  printedStickerNumber    String  @map("printed_sticker_number")
  printedMemberName       String? @map("printed_member_name")
  printedMembershipNumber String? @map("printed_membership_number")
  printedUnit             String? @map("printed_unit")
  printedBranch           String? @map("printed_branch")

  /// The officer signatures active at issue, as on `card`. `null` until CARD-07
  /// supplies them; the line then prints blank.
  presidentSignatureId        String? @map("president_signature_id") @db.Uuid
  generalSecretarySignatureId String? @map("general_secretary_signature_id") @db.Uuid

  // --- Reissue (`QUESTIONS.md` VEH-27 — item 26) -------------------------------
  /// When a reissue replaced this letter. A superseded letter is kept, exactly
  /// as printed, and is no longer downloadable.
  supersededAt     DateTime? @map("superseded_at")
  /// The letter this one replaced; `null` for a letter issued at onboarding.
  replacesLetterId String?   @unique @map("replaces_letter_id") @db.Uuid
  /// Why the officer reissued it. Required for a reissue (Requirement 18.1).
  reissueReason    String?   @map("reissue_reason")

  createdAt DateTime @default(now()) @map("created_at")

  vehicle      Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  sticker      Sticker @relation(fields: [stickerId], references: [id], onDelete: Restrict)
  issuedByUser User?   @relation("VehicleLetterIssuedBy", fields: [issuedByUserId], references: [id], onDelete: SetNull)

  /// `NoAction` rather than `Restrict`: checked at the end of the statement, so
  /// a test cleanup removing a letter and its replacement together succeeds.
  /// The application never deletes a letter.
  replaces   VehicleLetter? @relation("LetterReissue", fields: [replacesLetterId], references: [id], onDelete: NoAction)
  replacedBy VehicleLetter? @relation("LetterReissue")

  presidentSignature        OfficerSignature? @relation("LetterPresidentSignature", fields: [presidentSignatureId], references: [id], onDelete: Restrict)
  generalSecretarySignature OfficerSignature? @relation("LetterGeneralSecretarySignature", fields: [generalSecretarySignatureId], references: [id], onDelete: Restrict)

  @@index([vehicleId, issuedAt])
  @@index([stickerId])
  @@map("vehicle_letter")
}

// ---------------------------------------------------------------------------
// Users, roles, permissions (ARCHITECTURE.md Decisions 9.2–9.9)
// ---------------------------------------------------------------------------

model User {
  id           String @id @default(uuid()) @db.Uuid
  email        String @unique
  fullName     String @map("full_name")
  passwordHash String @map("password_hash")

  /// PRD Requirement 17.1 — multi-factor authentication is required for
  /// privileged roles. The mechanism is pluggable (Decision 9.3).
  mfaSecret        String?   @map("mfa_secret")
  mfaEnabledAt     DateTime? @map("mfa_enabled_at")
  /// The last time step a code was accepted for, so a code cannot be used
  /// twice (item 28).
  mfaLastStep      BigInt?   @map("mfa_last_step")
  /// A secret being set up, not yet confirmed by a code. It replaces
  /// `mfaSecret` only when confirmed, so a half-finished change of phone
  /// never leaves the officer without a working factor.
  mfaPendingSecret String?   @map("mfa_pending_secret")

  /// Consecutive failed sign-ins, password or code, and the lock they lead
  /// to. A six-digit code is only as strong as the limit on guessing it.
  failedSignInCount Int       @default(0) @map("failed_sign_in_count")
  signInLockedUntil DateTime? @map("sign_in_locked_until")

  /// Set when an administrator issues a temporary password (item 28). Until
  /// the officer chooses their own, the session can do nothing else.
  mustChangePassword Boolean @default(false) @map("must_change_password")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  roleAssignments           UserRoleAssignment[]
  permissionGrants          UserPermissionGrant[]      @relation("GrantSubject")
  grantsIssued              UserPermissionGrant[]      @relation("GrantIssuer")
  permissionRevocations     UserPermissionRevocation[] @relation("RevocationSubject")
  revocationsIssued         UserPermissionRevocation[] @relation("RevocationIssuer")
  applicationsRecorded      MembershipApplication[]    @relation("ApplicationCreatedBy")
  applicationsReviewed      MembershipApplication[]    @relation("ApplicationReviewedBy")
  cardsIssued               Card[]                     @relation("CardIssuedBy")
  cardsApproved             Card[]                     @relation("CardApprovedBy")
  stickersIssued            Sticker[]                  @relation("StickerIssuedBy")
  stickersAttached          Sticker[]                  @relation("StickerAttachedBy")
  lettersIssued             VehicleLetter[]            @relation("VehicleLetterIssuedBy")
  auditEvents               AuditEvent[]
  sessions                  UserSession[]
  paymentsInitiated         Payment[]
  dedicatedAccountsAssigned DedicatedAccount[]         @relation("DedicatedAccountAssignedBy")
  apiClientsRegistered      ApiClient[]                @relation("ApiClientRegisteredBy")
  apiClientsApproved        ApiClient[]                @relation("ApiClientApprovedBy")
  apiTokensCreated          ApiToken[]                 @relation("ApiTokenCreatedBy")
  apiPausesLifted           ApiClientPause[]           @relation("ApiClientPauseLiftedBy")
  recoveryCodes             UserRecoveryCode[]

  @@map("user")
}

/// Opaque server-side session.
///
/// ARCHITECTURE.md Decision 9.1 describes internal access as a *session*, and
/// this is why that word matters: revocation is a row change and takes effect on
/// the very next request. A signed JWT cannot offer that without a denylist,
/// which reintroduces exactly the lookup the JWT was meant to avoid — while
/// leaving a window in which a dismissed officer's token still works.
///
/// The token is stored hashed. A leaked database backup must not yield usable
/// credentials, on the same reasoning that hashes API tokens at PRD §12.1.
model UserSession {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @map("user_id") @db.Uuid
  tokenHash String @unique @map("token_hash")

  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  /// Recorded for the audit trail and for session review (PRD §18). Never
  /// returned to a caller.
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  /// When this session proved a second factor (Requirement 17.1, item 28).
  /// Null means it has not: it cannot exercise a privileged permission.
  mfaVerifiedAt DateTime? @map("mfa_verified_at")

  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_session")
}

/// A one-use code that stands in for the authenticator app when the phone is
/// lost (item 28). Shown once at enrolment; only its hash is kept.
model UserRecoveryCode {
  id       String    @id @default(uuid()) @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  codeHash String    @unique @map("code_hash")
  usedAt   DateTime? @map("used_at")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_recovery_code")
}

/// The permission catalogue.
///
/// ARCHITECTURE.md Decision 9.2 — a seeded table, not a TypeScript enumeration,
/// so a permission may be introduced without a schema migration. Code asks
/// whether the actor holds `vehicle.declare`; it never asks whether the actor is
/// a Vehicle-Record Officer.
model Permission {
  id          String @id @default(uuid()) @db.Uuid
  /// `resource.action`, e.g. `vehicle.declare`, `card.issue`, `audit.export`.
  code        String @unique
  description String

  /// Decision 9.7.3 — step-up re-authentication is built and available per
  /// permission. It is NOT presently enabled for `vehicle.declare`.
  requiresStepUp Boolean @default(false) @map("requires_step_up")

  createdAt DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]
  grants          UserPermissionGrant[]
  revocations     UserPermissionRevocation[]

  @@map("permission")
}

/// Roles are administrative bundles. They are never consulted in an
/// authorisation decision (Decision 9.2).
model Role {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  label       String
  description String?

  /// Decision 9.5 — the eleven roles of PRD §16 are seeded as system roles and
  /// cannot be edited or deleted, so a misconfiguration cannot silently broaden
  /// a role the Union believes it understands. A super administrator may compose
  /// additional roles from the catalogue.
  isSystem Boolean @default(false) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  permissions RolePermission[]
  assignments UserRoleAssignment[]

  @@map("role")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permission")
}

/// A role held by a user, within an organisational scope.
///
/// Decision 9.4 — the scope is a node of the hierarchy, or the root for
/// Union-wide authority. Without it the eleven roles collapse into a single
/// privilege level the moment a second branch exists.
model UserRoleAssignment {
  id             String @id @default(uuid()) @db.Uuid
  userId         String @map("user_id") @db.Uuid
  roleId         String @map("role_id") @db.Uuid
  organisationId String @map("organisation_id") @db.Uuid

  /// Who gave the role, and why (item 28). Null on rows the seed wrote. The
  /// full history, removals included, is in the audit trail.
  assignedByUserId String? @map("assigned_by_user_id") @db.Uuid
  reason           String?

  createdAt DateTime @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId, organisationId])
  @@index([userId])
  @@map("user_role_assignment")
}

/// An individual permission switched ON for a user who does not hold it by role.
///
/// Decision 9.7 — `vehicle.declare` belongs to no system role bundle other than
/// super administrator, so this table is load-bearing for declaration work. That
/// is the intended effect: the Union can answer "who may declare a vehicle" as an
/// enumerable list of named grants rather than an inference across role
/// membership (Decision 9.7.1).
model UserPermissionGrant {
  id             String @id @default(uuid()) @db.Uuid
  userId         String @map("user_id") @db.Uuid
  permissionId   String @map("permission_id") @db.Uuid
  organisationId String @map("organisation_id") @db.Uuid

  grantedByUserId String   @map("granted_by_user_id") @db.Uuid
  reason          String
  createdAt       DateTime @default(now()) @map("created_at")

  user         User         @relation("GrantSubject", fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  grantedBy    User         @relation("GrantIssuer", fields: [grantedByUserId], references: [id], onDelete: Restrict)

  @@unique([userId, permissionId, organisationId])
  @@index([permissionId])
  @@map("user_permission_grant")
}

/// An individual permission switched OFF for a user who does hold it by role.
///
/// Decision 9.3 — REVOCATION ALWAYS WINS. Where a permission is both granted and
/// revoked for the same user and scope, it is withheld. Ambiguity in an
/// access-control system must resolve towards denial.
model UserPermissionRevocation {
  id             String @id @default(uuid()) @db.Uuid
  userId         String @map("user_id") @db.Uuid
  permissionId   String @map("permission_id") @db.Uuid
  organisationId String @map("organisation_id") @db.Uuid

  revokedByUserId String   @map("revoked_by_user_id") @db.Uuid
  reason          String
  createdAt       DateTime @default(now()) @map("created_at")

  user       User       @relation("RevocationSubject", fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  revokedBy  User       @relation("RevocationIssuer", fields: [revokedByUserId], references: [id], onDelete: Restrict)

  @@unique([userId, permissionId, organisationId])
  @@index([permissionId])
  @@map("user_permission_revocation")
}

// ---------------------------------------------------------------------------
// External API clients and disclosure (PRD §12, §15)
// ---------------------------------------------------------------------------

model ApiClient {
  id               String          @id @default(uuid()) @db.Uuid
  organisationName String          @map("organisation_name")
  /// `EXPIRED` is never written. It is worked out from the tokens' dates
  /// (`apiClientStanding` in `@nurtw/domain`), so it is true the moment a token
  /// runs out and needs no job to notice.
  status           ApiClientStatus @default(PENDING)

  /// The last status change, and the reason the officer gave. The full history
  /// is in the audit trail.
  statusChangedAt DateTime? @map("status_changed_at")
  statusReason    String?   @map("status_reason")

  /// PRD §12.1 — the business purpose, the approving officer, and the technical
  /// contact are part of the approval record, not optional metadata.
  businessPurpose String @map("business_purpose")

  /// Requirement 12.6 — the rotation reminder is addressed to this contact.
  technicalContactName  String  @map("technical_contact_name")
  technicalContactEmail String  @map("technical_contact_email")
  technicalContactPhone String? @map("technical_contact_phone")

  registeredByUserId String?   @map("registered_by_user_id") @db.Uuid
  /// PRD §12.1's "named NURTW sponsor or approving officer" (Requirement 12.9).
  approvedByUserId   String?   @map("approved_by_user_id") @db.Uuid
  approvedAt         DateTime? @map("approved_at")

  /// Requirement 12.8 — the data-sharing agreement, without which a client is
  /// not approved. Nullable because a pending client need not have one yet.
  agreementReference String?   @map("agreement_reference")
  agreementDate      DateTime? @map("agreement_date") @db.Date

  /// Decision 5.2 — the profile is a row, so admitting a new class of external
  /// organisation is configuration rather than a release.
  disclosureProfileId String? @map("disclosure_profile_id") @db.Uuid

  /// PRD §12.1 — allowed source ranges where practical. Empty means any address.
  allowedIpRanges String[] @map("allowed_ip_ranges")

  /// PRD §14 (item 13) — the limit profile the organisation is held to.
  rateLimitProfile String @default("STANDARD") @map("rate_limit_profile")
  /// A daily quota of its own, where its profile's does not fit. Null means
  /// the profile's.
  dailyQuota       Int?   @map("daily_quota")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  disclosureProfile DisclosureProfile? @relation(fields: [disclosureProfileId], references: [id], onDelete: Restrict)
  registeredByUser  User?              @relation("ApiClientRegisteredBy", fields: [registeredByUserId], references: [id], onDelete: SetNull)
  approvedByUser    User?              @relation("ApiClientApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  limitProfile      RateLimitProfile   @relation(fields: [rateLimitProfile], references: [code], onDelete: Restrict, onUpdate: Restrict)
  tokens            ApiToken[]
  scopes            ApiClientScope[]
  requests          ApiRequestLog[]
  rateBuckets       ApiRateBucket[]
  rateCounters      ApiRateCounter[]
  abuseWindows      ApiAbuseWindow[]
  sequenceStates    ApiSequenceState[]
  pauses            ApiClientPause[]

  @@index([status])
  @@map("api_client")
}

/// PRD Requirement 12.1–12.2 — tokens are stored as hashes. The secret is shown
/// once, at creation or rotation, and never appears in a URL, in browser-delivered
/// code, in a QR payload, in a log, or in an error message.
model ApiToken {
  id       String @id @default(uuid()) @db.Uuid
  clientId String @map("client_id") @db.Uuid

  tokenHash   String @unique @map("token_hash")
  /// Short non-secret prefix, so a token can be identified in an audit trail
  /// without storing anything that could authenticate a request.
  tokenPrefix String @map("token_prefix")

  /// PRD Requirement 12.6 — 90 days, determined at §23.12.
  expiresAt DateTime  @map("expires_at")
  /// Revocation is a state change and takes effect immediately, without a
  /// redeployment (PRD acceptance criterion 11).
  revokedAt DateTime? @map("revoked_at")

  /// Requirement 12.10 — set when a newer token replaces this one: the moment
  /// this one stops being accepted. `expiresAt` is left as it was, so the
  /// record still says how long the token was issued for.
  retiresAt          DateTime? @map("retires_at")
  /// The token this one replaced. Unique: a token is replaced once.
  rotatedFromTokenId String?   @unique @map("rotated_from_token_id") @db.Uuid

  /// To the minute, and written at most once a minute. It tells an officer
  /// whether an organisation has moved to its new token yet.
  lastUsedAt DateTime? @map("last_used_at")

  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  client        ApiClient       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  rotatedFrom   ApiToken?       @relation("TokenRotation", fields: [rotatedFromTokenId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rotatedTo     ApiToken?       @relation("TokenRotation")
  createdByUser User?           @relation("ApiTokenCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  requests      ApiRequestLog[]

  @@index([clientId])
  @@map("api_token")
}

/// Scopes held by a client. A join table rather than an array column so that a
/// scope grant can be indexed, audited, and revoked individually.
model ApiClientScope {
  clientId String @map("client_id") @db.Uuid
  scope    String

  createdAt DateTime @default(now()) @map("created_at")

  client ApiClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@id([clientId, scope])
  @@map("api_client_scope")
}

/// PRD §15, Decision 5.2 — disclosure profiles are configuration data.
///
/// Decision 5.1 — responses are built by PROJECTION through the permitted field
/// set below, never by fetching a record and removing fields. Redaction fails
/// unsafely: a column added later would be disclosed by default.
model DisclosureProfile {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  label       String
  description String?

  /// Seeded from PRD §15 (`SYSTEM_DISCLOSURE_PROFILES` in `@nurtw/contracts`).
  /// A system profile cannot be amended through the interface, so that
  /// "Minimal verification" goes on meaning what the PRD says it means.
  isSystem Boolean @default(false) @map("is_system")
  /// Withdrawn, never deleted. An inactive profile cannot be newly assigned.
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  fields  DisclosureField[]
  clients ApiClient[]

  @@map("disclosure_profile")
}

/// A field a profile is permitted to disclose. Absence means withheld; there is
/// no implicit inclusion.
model DisclosureField {
  profileId String @map("profile_id") @db.Uuid
  /// The name of a field in the closed verification catalogue
  /// (`VERIFICATION_FIELDS` in `@nurtw/domain`), e.g. `vehicle_category`. It is
  /// the name the response carries. Only an external-admissible field is ever
  /// written here, and the projection drops any other regardless.
  fieldPath String @map("field_path")

  profile DisclosureProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([profileId, fieldPath])
  @@map("disclosure_field")
}

/// PRD §24 `api_request` — usage and audit for external calls.
model ApiRequestLog {
  id              String  @id @default(uuid()) @db.Uuid
  requestId       String  @map("request_id")
  clientId        String? @map("client_id") @db.Uuid
  /// PRD §17 — the access log names the token used. Its id, never its value.
  /// Null where the request presented no token this System issued.
  tokenId         String? @map("token_id") @db.Uuid
  /// PRD §18 — the source address of API activity.
  ipAddress       String? @map("ip_address")
  endpoint        String
  scope           String?
  /// Coarse outcome class. PRD Requirement 14.3 — the caller receives a generic
  /// negative; the distinction is recorded here and withheld from them.
  resultClass     String  @map("result_class")
  statusCode      Int     @map("status_code")
  rateLimited     Boolean @default(false) @map("rate_limited")
  /// Proposal §14.3 — the id the System gave the request, beside the caller's
  /// own `request_id`. Returned as `X-Server-Request-ID`.
  serverRequestId String? @map("server_request_id")

  /// PRD §26.4 — which identifier scheme resolved the lookup, so legacy exposure
  /// is measurable rather than assumed.
  identifierScheme IdentifierScheme? @map("identifier_scheme")

  createdAt DateTime @default(now()) @map("created_at")

  client ApiClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  token  ApiToken?  @relation(fields: [tokenId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
  @@index([requestId])
  @@map("api_request_log")
}

/// PRD §14, §23.12 — the numbers an external organisation is held to
/// (item 13): its rates, burst, and quotas, and the thresholds abuse detection
/// applies to it. A row, so the Union changes any of them without a release
/// (Requirement 14.1, Decision 8.3). The code is fixed once created.
model RateLimitProfile {
  code        String  @id
  label       String
  description String?

  verificationPerMinute Int  @map("verification_per_minute")
  aggregatePerMinute    Int  @map("aggregate_per_minute")
  burst                 Int
  hourlyQuota           Int? @map("hourly_quota")
  dailyQuota            Int  @map("daily_quota")

  windowMinutes     Int @map("window_minutes")
  forgeryThreshold  Int @map("forgery_threshold")
  missThreshold     Int @map("miss_threshold")
  missPercent       Int @map("miss_percent")
  sequenceThreshold Int @map("sequence_threshold")
  sequenceReach     Int @map("sequence_reach")
  pauseMinutes      Int @map("pause_minutes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  clients ApiClient[]

  @@map("rate_limit_profile")
}

/// A token bucket per organisation and route class (Decision 8.2). Written
/// only by one atomic statement in `RateLimitService`, so two instances cannot
/// both spend the last token. `allowed` is whether that statement let the
/// last request through.
model ApiRateBucket {
  clientId   String   @map("client_id") @db.Uuid
  routeClass String   @map("route_class")
  tokens     Float
  allowed    Boolean
  updatedAt  DateTime @map("updated_at") @db.Timestamptz(3)

  client ApiClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@id([clientId, routeClass])
  @@map("api_rate_bucket")
}

/// Requests let through per organisation, per clock hour and per Lagos day.
/// Pruned once the window has passed.
model ApiRateCounter {
  clientId    String   @map("client_id") @db.Uuid
  /// `HOUR` or `DAY`.
  period      String
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  count       Int

  client ApiClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@id([clientId, period, windowStart])
  @@index([windowStart])
  @@map("api_rate_counter")
}

/// Abuse detection's counts for one organisation over one fixed window
/// (Requirement 14.2): checks decided, non-matches, and forged codes.
model ApiAbuseWindow {
  clientId    String   @map("client_id") @db.Uuid
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  checks      Int
  misses      Int
  forgeries   Int

  client ApiClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@id([clientId, windowStart])
  @@index([windowStart])
  @@map("api_abuse_window")
}

/// The last plate or Transpay barcode an organisation presented, as a stem and
/// a number, and the run of non-matching steps it is in. One row per kind,
/// overwritten on each check and pruned when stale: detection state, not a log
/// of what was asked.
model ApiSequenceState {
  clientId  String   @map("client_id") @db.Uuid
  /// `PLATE` or `CODE`.
  kind      String
  stem      String
  number    BigInt
  run       Int
  updatedAt DateTime @map("updated_at") @db.Timestamptz(3)

  client ApiClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@id([clientId, kind])
  @@map("api_sequence_state")
}

/// Each time abuse detection paused an organisation (the owner's direction of
/// 3 October 2026). Kept after it ends or is lifted, so the history shows.
/// A pause holds while `liftedAt` is null and `pausedUntil` is ahead.
model ApiClientPause {
  id          String   @id @default(uuid()) @db.Uuid
  clientId    String   @map("client_id") @db.Uuid
  /// An `AbuseSignal` from `@nurtw/domain`.
  signal      String
  pausedAt    DateTime @map("paused_at")
  pausedUntil DateTime @map("paused_until")
  /// The counts that raised it. Never an identifier.
  evidence    Json

  liftedAt       DateTime? @map("lifted_at")
  liftedByUserId String?   @map("lifted_by_user_id") @db.Uuid
  liftReason     String?   @map("lift_reason")

  client   ApiClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  liftedBy User?     @relation("ApiClientPauseLiftedBy", fields: [liftedByUserId], references: [id], onDelete: SetNull)

  @@index([clientId, pausedAt])
  @@map("api_client_pause")
}

// ---------------------------------------------------------------------------
// Audit (PRD §18, ARCHITECTURE.md Decisions 7.1–7.3)
// ---------------------------------------------------------------------------

/// Append-only. Decision 7.2 — no application code path updates or deletes a row
/// here. Retention is enforced by an administrative process operating outside the
/// application's write path.
///
/// Decision 7.3 — rows record actor, action, subject, before and after values for
/// material changes, timestamp, request id, and the stated reason for an override.
/// They must NOT record token values, images, signatures, or guarantor details.
model AuditEvent {
  id String @id @default(uuid()) @db.Uuid

  /// `resource.action`, matching the permission catalogue's convention. A string
  /// rather than an enum: the set grows with every module, and an enum would make
  /// adding an audited action a schema migration.
  action String

  actorUserId      String? @map("actor_user_id") @db.Uuid
  actorApiClientId String? @map("actor_api_client_id") @db.Uuid
  organisationId   String? @map("organisation_id") @db.Uuid

  /// Subject of the action, e.g. "vehicle" and its id.
  subjectType String  @map("subject_type")
  subjectId   String? @map("subject_id")

  /// Before and after values for material changes (Decision 7.3). Json here is
  /// deliberate: the shape varies by subject, and enumerating every column of
  /// every table would couple the audit trail to each schema change.
  beforeValue Json? @map("before_value")
  afterValue  Json? @map("after_value")

  /// Required for manual overrides, corrections, replacements, and suspensions
  /// (PRD Requirement 18.1).
  reason String?

  requestId String? @map("request_id")
  ipAddress String? @map("ip_address")

  createdAt DateTime @default(now()) @map("created_at")

  actorUser    User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)

  @@index([subjectType, subjectId])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_event")
}

/// PRD Requirement 14.1 and 13.3 — limits, quotas, and the suppression threshold
/// must be adjustable by a Union administrator at runtime, without a deployment.
/// A code constant would break that promise.
model SystemSetting {
  key         String  @id
  value       String
  description String?

  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("system_setting")
}

// ---------------------------------------------------------------------------
// Payments (PRD §27, revision 1.2)
// ---------------------------------------------------------------------------

/// A fee is charged once (a sticker) or on a schedule (levy, membership).
enum FeeRecurrence {
  ONE_OFF
  MONTHLY
  YEARLY
}

/// PRD Requirement 27.1 — what the fee is charged against, not who pays it:
/// the levy is charged per vehicle even though a member's card settles it.
enum ChargedAgainst {
  MEMBER
  VEHICLE
}

/// PRD Requirement 27.4 — a sticker fee goes wholly to the contractor; a due
/// splits, part settling to the NURTW subaccount.
enum FeeSettlement {
  CONTRACTOR_ONLY
  SPLIT_WITH_NURTW
}

/// PRD Requirement 27.7 / PAY-11 — a sticker fee is link-only; NURTW dues may
/// use either. The channel actually used is recorded on the payment, not
/// inferred from the fee type, because a Union due can go either way.
enum PaymentChannel {
  LINK
  DEDICATED_ACCOUNT
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

/// PRD Requirement 27.9 — the ledger is append-only; a refund is a new DEBIT
/// row, never an edit to the original CREDIT.
enum LedgerDirection {
  CREDIT
  DEBIT
}

/// Fee types are data, not code (Requirement 27.1). Adding one, or re-pricing
/// an existing one, is a settings change — never a deployment.
model FeeType {
  id String @id @default(uuid()) @db.Uuid

  /// Stable machine code, e.g. "STICKER_REATTACHMENT". Referenced by payments;
  /// never repurposed once issued against a real payment.
  code  String @unique
  label String

  /// Requirement 27.2 — the launch amounts are NOT placeholders and may be
  /// charged live; a later fee type may set `isPlaceholder` to block that.
  amountKobo Int @map("amount_kobo")

  recurrence     FeeRecurrence
  chargedAgainst ChargedAgainst @map("charged_against")
  settlement     FeeSettlement

  active        Boolean @default(true)
  isPlaceholder Boolean @default(false) @map("is_placeholder")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  payments      Payment[]
  prices        FeeTypePrice[]
  amountHistory FeeAmountHistory[]

  @@map("fee_type")
}

/// A fee type's amount for one route type (PRD Requirement 27.1, revision 1.3,
/// `QUESTIONS.md` PAY-14). The levy is priced per route type; a route type
/// with no row here is charged the fee type's default `amountKobo`.
///
/// Data, not code: the Union adds or re-prices a row from settings, audited
/// with a mandatory reason (Requirement 27.2). A payment snapshots the amount
/// it was initiated at (`Payment.dueKobo`), so a later re-price never changes
/// an in-flight payment.
model FeeTypePrice {
  id String @id @default(uuid()) @db.Uuid

  feeTypeId   String @map("fee_type_id") @db.Uuid
  routeTypeId String @map("route_type_id") @db.Uuid
  amountKobo  Int    @map("amount_kobo")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  feeType   FeeType   @relation(fields: [feeTypeId], references: [id], onDelete: Restrict)
  routeType RouteType @relation(fields: [routeTypeId], references: [id], onDelete: Restrict)

  @@unique([feeTypeId, routeTypeId])
  @@index([routeTypeId])
  @@map("fee_type_price")
}

/// Every amount a fee type has had, and when it took effect (item 22).
///
/// `fee_type.amount_kobo` and `fee_type_price` hold the amount charged *now*.
/// A monthly levy needs the amount that was in force on the 1st of each past
/// month: without it, raising the levy would re-price every month already
/// paid and show a shortfall on each (PRD Requirement 27.13).
///
/// Append-only (Requirement 27.9): `FeeTypeService` adds a row in the same
/// transaction as every amount change, and no row is ever updated or removed.
/// `routeTypeId` is null for the fee type's default amount. A key with no rows
/// has never changed, so its current amount has applied from the beginning.
model FeeAmountHistory {
  id String @id @default(uuid()) @db.Uuid

  feeTypeId   String  @map("fee_type_id") @db.Uuid
  routeTypeId String? @map("route_type_id") @db.Uuid
  amountKobo  Int     @map("amount_kobo")

  /// When this amount started to apply. The first change to a key also writes
  /// the amount it replaced, effective from the epoch, as the baseline.
  effectiveFrom DateTime @map("effective_from")

  changedByUserId String?  @map("changed_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  feeType   FeeType    @relation(fields: [feeTypeId], references: [id], onDelete: Restrict)
  routeType RouteType? @relation(fields: [routeTypeId], references: [id], onDelete: Restrict)

  @@index([feeTypeId, routeTypeId, effectiveFrom])
  @@map("fee_amount_history")
}

/// A single charge against a member or a vehicle. `subjectType`/`subjectId`
/// avoid a foreign key to either table directly, because a fee type can be
/// charged against either (Requirement 27.1) and the set of subjects a fee
/// can apply to must stay a data question, not a schema one.
model Payment {
  id String @id @default(uuid()) @db.Uuid

  feeTypeId   String @map("fee_type_id") @db.Uuid
  subjectType String @map("subject_type")
  subjectId   String @map("subject_id") @db.Uuid

  /// The due itself, before any fee (Requirement 27.3). Snapshotted from the
  /// fee type's amount at initiation, so a later re-price never changes what
  /// an in-flight payment asked for.
  dueKobo Int @map("due_kobo")

  /// Requirement 27.3 — the contractor's fee, shown to the payer as its own
  /// line. Zero for a dedicated-account payment (PAY-11 uses a fixed Paystack
  /// percentage there, not this formula).
  contractorFeeKobo Int @map("contractor_fee_kobo")

  /// What the payer was asked to pay. Equal to `dueKobo` for a
  /// dedicated-account credit, where the member chooses the amount.
  totalChargedKobo Int @map("total_charged_kobo")

  /// Item 23 — the dedicated-account transfer this payment was allocated
  /// from. Such a payment pays one due period, in full or in part, and is
  /// confirmed when it is written: the transfer was verified with Paystack
  /// first (Requirement 27.5).
  dedicatedTransferId String? @map("dedicated_transfer_id") @db.Uuid

  /// The due period a dedicated-account allocation paid: `2026-11` for a
  /// levy month, or the Lagos date a membership fee fell due. What a receipt
  /// names as "the due and its period" (Requirement 27.14). Null for a link
  /// payment, which pays whatever falls oldest when the schedule is read.
  duePeriod String? @map("due_period")

  channel PaymentChannel
  status  PaymentStatus  @default(PENDING)

  /// Paystack's transaction reference. Unique so a webhook retry, or a
  /// server-side verification race with the webhook, can never confirm the
  /// same payment twice (Requirement 27.5).
  ///
  /// A dedicated-account allocation carries its transfer's reference with
  /// `:1`, `:2`, … appended, because one transfer can pay several dues. The
  /// transfer row holds Paystack's reference itself.
  paystackReference String @unique @map("paystack_reference")

  /// Recorded once Paystack settles, for the loss-detection check at
  /// Requirement 27.6 (expected fee vs. what Paystack actually took).
  paystackFeeKobo Int? @map("paystack_fee_kobo")

  initiatedByUserId String?   @map("initiated_by_user_id") @db.Uuid
  confirmedAt       DateTime? @map("confirmed_at")
  refundedAt        DateTime? @map("refunded_at")
  refundReason      String?   @map("refund_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  feeType           FeeType                   @relation(fields: [feeTypeId], references: [id], onDelete: Restrict)
  initiatedByUser   User?                     @relation(fields: [initiatedByUserId], references: [id], onDelete: SetNull)
  dedicatedTransfer DedicatedAccountTransfer? @relation(fields: [dedicatedTransferId], references: [id], onDelete: Restrict)

  ledgerEntries   LedgerEntry[]
  fundsAttachment Sticker?

  @@index([subjectType, subjectId])
  @@index([status])
  @@index([feeTypeId])
  @@index([dedicatedTransferId])
  @@map("payment")
}

/// A personal pay link (PRD Requirement 27.8, revision 1.9; `QUESTIONS.md`
/// PAY-21 — item 31). Its code opens a public page offering published amounts
/// only, never what the subject owes. The code is not a credential, so it is
/// stored as it is (see `packages/domain/src/payments/pay-link.ts`).
///
/// Replaced, never deleted. At most one live link per subject, by the partial
/// unique index `pay_link_one_live_per_subject` in the migration, which Prisma
/// cannot express.
model PayLink {
  id          String @id @default(uuid()) @db.Uuid
  code        String @unique
  /// `vehicle` or `member`.
  subjectType String @map("subject_type")
  subjectId   String @map("subject_id") @db.Uuid

  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  revokedAt       DateTime? @map("revoked_at")
  revokedByUserId String?   @map("revoked_by_user_id") @db.Uuid
  revokeReason    String?   @map("revoke_reason")

  @@index([subjectType, subjectId])
  @@map("pay_link")
}

/// Per-address counters for the public pay routes (item 31). One atomic
/// statement per write, keyed by a hash of the address; pruned after a day.
model PublicRateCounter {
  key         String
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  count       Int

  @@id([key, windowStart])
  @@map("public_rate_counter")
}

/// Append-only (Requirement 27.9). A correction or a refund is a new DEBIT
/// row referencing the same payment — never an update or a delete.
model LedgerEntry {
  id String @id @default(uuid()) @db.Uuid

  paymentId   String          @map("payment_id") @db.Uuid
  direction   LedgerDirection
  amountKobo  Int             @map("amount_kobo")
  description String?

  createdAt DateTime @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@map("ledger_entry")
}

/// The NURTW settlement account (Requirement 27.12). A singleton: the row
/// with `isActive = true` is the one dues currently split to. Saving a
/// change updates the *same* Paystack subaccount in place — never a second
/// row's `subaccountCode` — so dedicated accounts and payment links already
/// issued keep settling correctly. History is not modelled here: it lives in
/// `AuditEvent` (subjectType "settlement_account"), which already carries
/// actor, before/after, reason, IP address, and failed attempts.
model SettlementAccount {
  id String @id @default(uuid()) @db.Uuid

  bankCode      String @map("bank_code")
  bankName      String @map("bank_name")
  accountNumber String @map("account_number")

  /// Resolved from Paystack and shown to the administrator for confirmation
  /// before saving (Requirement 27.12) — never free-typed.
  accountName String @map("account_name")

  /// The one Paystack subaccount every NURTW due settles a share to. Created
  /// on the first save; every later save updates this same code's bank
  /// details at Paystack rather than minting a new subaccount.
  subaccountCode String @unique @map("subaccount_code")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settlement_account")
}

/// PRD Requirement 27.7 / PAY-11 — how a dedicated-account transfer's credit
/// was worked out.
enum DedicatedCreditBasis {
  /// The amount Paystack reports settling to the NURTW subaccount.
  PAYSTACK_SPLIT
  /// The contractor percentage setting, when Paystack's figure was absent.
  PERCENTAGE_SETTING
}

/// A member's Paystack dedicated virtual account (PRD Requirement 27.7, item
/// 23). An ordinary bank account number: a POS agent or any banking app can
/// pay into it, with no smartphone or card (PAY-17).
///
/// Assigned with the NURTW subaccount, so every transfer into it splits at
/// Paystack and settles straight to NURTW; the contractor never holds Union
/// money (PAY-11). Only NURTW dues are paid this way. A sticker fee is always
/// paid by link.
///
/// History is kept: an account is deactivated, never deleted. At most one
/// active account per member is a PARTIAL unique index, raw SQL in the
/// migration, for the reason `Vehicle` documents:
///
///     CREATE UNIQUE INDEX dedicated_account_one_active_per_member
///     ON dedicated_account (member_id) WHERE active
model DedicatedAccount {
  id String @id @default(uuid()) @db.Uuid

  memberId String @map("member_id") @db.Uuid

  /// Paystack's customer and account identifiers. A transfer is matched to
  /// its member by the customer code on the verified transaction.
  paystackCustomerCode String @map("paystack_customer_code")
  paystackAccountId    Int    @unique @map("paystack_account_id")

  accountNumber String @map("account_number")
  accountName   String @map("account_name")
  bankName      String @map("bank_name")
  bankSlug      String @map("bank_slug")

  active Boolean @default(true)

  assignedAt       DateTime @default(now()) @map("assigned_at")
  assignedByUserId String?  @map("assigned_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  member         Member @relation(fields: [memberId], references: [id], onDelete: Restrict)
  assignedByUser User?  @relation("DedicatedAccountAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  transfers DedicatedAccountTransfer[]

  @@index([memberId])
  @@index([paystackCustomerCode])
  @@map("dedicated_account")
}

/// Money received into a dedicated account (item 23). Append-only
/// (Requirement 27.9).
///
/// The member sends what they choose, so a transfer is not itself a payment
/// for a due. It is credited with what NURTW received, then allocated to the
/// member's oldest outstanding dues as `Payment` rows (PAY-12). What a
/// transfer still holds is its credit less those payments: derived, never
/// stored, so there is no balance to drift.
model DedicatedAccountTransfer {
  id String @id @default(uuid()) @db.Uuid

  dedicatedAccountId String @map("dedicated_account_id") @db.Uuid
  memberId           String @map("member_id") @db.Uuid

  /// Paystack's reference. Unique, so a replayed webhook records nothing new
  /// (Requirement 27.5).
  paystackReference String @unique @map("paystack_reference")

  /// What the member sent.
  amountKobo Int @map("amount_kobo")

  /// What NURTW received, and so what the member is credited (Requirement
  /// 27.7: "net of Paystack's fee and the contractor's percentage").
  creditKobo  Int                  @map("credit_kobo")
  creditBasis DedicatedCreditBasis @map("credit_basis")

  /// Paystack's fee on the transfer, for the loss check at Requirement 27.6.
  paystackFeeKobo Int? @map("paystack_fee_kobo")

  /// When the member's bank paid it, as Paystack reports.
  receivedAt DateTime @map("received_at")
  createdAt  DateTime @default(now()) @map("created_at")

  dedicatedAccount DedicatedAccount @relation(fields: [dedicatedAccountId], references: [id], onDelete: Restrict)
  member           Member           @relation(fields: [memberId], references: [id], onDelete: Restrict)

  allocations Payment[]

  @@index([memberId])
  @@index([dedicatedAccountId])
  @@map("dedicated_account_transfer")
}
