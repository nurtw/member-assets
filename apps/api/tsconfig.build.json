{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    // Inherited as true for type-checking; TypeScript forbids it alongside
    // emit, and prisma/ is outside this build anyway.
    "allowImportingTsExtensions": false
  },
  "include": ["src"],
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts"]
}
